# 코어세일즈 .env.local 과 Vercel(Production)에 같은 이름으로 넣는다. 값은 직접 채운다.
# (이 파일은 예시일 뿐이다. 실제 키를 여기에 적지 말 것.)

# Supabase > Project Settings > API 의 Project URL (https://<프로젝트 ref>.supabase.co)
SUPABASE_URL=
# Supabase > Project Settings > API Keys 의 secret 키 (sb_secret_...). 서버 전용.
SUPABASE_SECRET_KEY=
# Aside가 /api/outreach/agent/* 를 호출할 때 x-outreach-key 헤더로 보내는 값. 긴 랜덤 문자열.
OUTREACH_API_KEY=
# /outreach 화면 로그인 비밀번호.
OUTREACH_ADMIN_PASSWORD=
